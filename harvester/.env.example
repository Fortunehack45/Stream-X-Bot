# ============================================================
#  Movie Harvester — Environment Configuration Template
#  Copy this file to `.env` and fill in your actual values.
#  Get your TMDB API key at: https://www.themoviedb.org/settings/api
# ============================================================

# ── TMDB ─────────────────────────────────────────────────────
TMDB_API_KEY=your_tmdb_v3_api_key_here

# ── Scraper Target ───────────────────────────────────────────
# The URL the browser agent will navigate to on each harvest cycle.
TARGET_URL=https://your-target-site.com/movies

# ── PostgreSQL (must match docker-compose.yml) ───────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=movie_harvester
DB_USER=harvester
DB_PASSWORD=strongpassword

# ── Scheduler ────────────────────────────────────────────────
# How often (in hours) a harvest cycle runs. Default: 6 hours.
SCRAPE_INTERVAL_HOURS=6

# ── Scraper Behaviour ────────────────────────────────────────
# Seconds to wait for JavaScript rendering after page load.
PAGE_LOAD_WAIT_SECONDS=8
# Maximum retry attempts per page/request before giving up.
MAX_RETRY_ATTEMPTS=5
# Base delay (seconds) for exponential backoff (doubles each retry).
RETRY_BASE_DELAY_SECONDS=2
